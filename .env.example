# CloudStoragePX Configuration Environment Template

# Port for the Node.js application server (default: 3000)
PORT=3000

# Node Environment: 'development' or 'production'
NODE_ENV=development

# 256-bit Hex Encryption Key for AES-256-GCM (Optional; automatically generated in data/.vault_key if omitted)
# STORAGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public Application URL (used for generating public share links and redirects)
APP_URL="http://localhost:3000"

# Google OAuth 2.0 / OpenID Connect credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# GitHub OAuth App credentials
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL=""

# AI Studio runtime vars (injected automatically in cloud preview)
GEMINI_API_KEY=""
